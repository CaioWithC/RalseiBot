{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "includeFiles": "web/**"
    },
    "api/*.py": {
      "includeFiles": "web/**"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index?__route__=/$1"
    }
  ]
}
