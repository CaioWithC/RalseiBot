# Discord Bot Token
DISCORD_TOKEN=your_discord_bot_token_here

# Web Dashboard OAuth2 Configuration (Necessário para login oficial com Discord)
# Obtenha em https://discord.com/developers/applications
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Local: http://localhost:5000/callback
# Vercel: https://ralseibot.vercel.app/callback
DISCORD_REDIRECT_URI=https://ralseibot.vercel.app/callback

# Segredo de sessão Flask (Opcional, gerado automaticamente a partir do token se omitido)
SECRET_KEY=

# Banco de dados remoto (Opcional - PostgreSQL, Supabase, Neon ou Turso para sincronizar com bot)
# BOT_DATABASE_URL=postgresql://user:pass@host/db

# Web Dashboard Port (para execução local)
DASHBOARD_PORT=5000
